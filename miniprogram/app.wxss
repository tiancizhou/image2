/* Kawaii Minimal 全局样式 */
page {
  background: #FFF8F0;
  color: #333;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

/* 糖果色 */
.primary { color: #6c5ce7; }
.pink { color: #fd79a8; }
.mint { color: #00b894; }
.yellow { color: #fdcb6e; }

/* 卡片 */
.card {
  background: #fff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin: 20rpx 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(108, 92, 231, 0.06);
}

/* 按钮 */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: all 0.25s ease-out;
}

.btn::after { border: none; }

.btn:active {
  transform: scale(0.96);
}

.btn-primary {
  background: linear-gradient(135deg, #a29bfe, #6c5ce7);
  color: #fff;
}

.btn-pink {
  background: linear-gradient(135deg, #fab1a0, #fd79a8);
  color: #fff;
}

.btn-mint {
  background: linear-gradient(135deg, #55efc4, #00b894);
  color: #fff;
}

.btn-disabled {
  background: #dfe6e9;
  color: #b2bec3;
}

/* 输入框 */
.input-area {
  background: #f8f0ff;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  min-height: 180rpx;
  width: 100%;
}

.input-single {
  background: #f8f0ff;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  width: 100%;
}

/* 标签 */
.tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.tag-active {
  background: linear-gradient(135deg, #a29bfe, #6c5ce7);
  color: #fff;
}

.tag-inactive {
  background: #f0edff;
  color: #6c5ce7;
}

/* Section title */
.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #636e72;
  margin: 20rpx 24rpx 16rpx;
}

/* Empty state */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
  color: #b2bec3;
}

.empty-state text {
  font-size: 28rpx;
  margin-top: 16rpx;
}

/* Image result */
.result-image {
  width: 100%;
  border-radius: 20rpx;
  margin-top: 20rpx;
}

/* Loading */
.loading-wrap {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx;
}

.loading-dots {
  display: flex;
  gap: 12rpx;
}

.loading-dots view {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #a29bfe;
  animation: bounce 1.4s ease-in-out infinite;
}

.loading-dots view:nth-child(2) { animation-delay: 0.16s; }
.loading-dots view:nth-child(3) { animation-delay: 0.32s; }

@keyframes bounce {
  0%, 80%, 100% { transform: scale(0.6); opacity: 0.4; }
  40% { transform: scale(1); opacity: 1; }
}
