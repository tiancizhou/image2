<view class="page" wx:if="{{item}}">
  <view class="card image-card">
    <view class="image-tag">{{item.type_text}}</view>
    <image
      class="detail-image"
      src="{{item.image_url}}"
      mode="widthFix"
      show-menu-by-longpress
      bindtap="onPreviewImage"
    />
  </view>

  <view class="card info-card">
    <view class="prompt-block">
      <text class="block-label">提示词</text>
      <text class="prompt-text">{{item.prompt}}</text>
    </view>
    <view class="info-grid">
      <view class="info-pill">
        <text class="detail-label">尺寸</text>
        <text class="detail-value">{{item.size}}</text>
      </view>
      <view class="info-pill">
        <text class="detail-label">类型</text>
        <text class="detail-value">{{item.type_text}}</text>
      </view>
      <view class="info-pill">
        <text class="detail-label">积分</text>
        <text class="detail-value">{{item.points_cost}}</text>
      </view>
    </view>
    <view class="time-row">
      <text>生成时间</text>
      <text>{{item.created_at_text}}</text>
    </view>
  </view>

  <view class="card action-card">
    <view class="action-btn action-primary" wx:if="{{!isSharedView}}" bindtap="onRemix">
      <text>基于此图再创作</text>
      <text class="action-sub">带入图生图继续调整</text>
    </view>
    <view class="action-btn action-primary" wx:else bindtap="goCreate">
      <text>我也去创作</text>
      <text class="action-sub">打开梦倩绘境生成你的图片</text>
    </view>
    <view class="action-row">
      <view class="action-btn action-secondary" bindtap="onSaveImage">保存到相册</view>
      <view class="action-btn action-danger" wx:if="{{!isSharedView}}" bindtap="onDelete">删除记录</view>
    </view>
  </view>
</view>
