<view class="page">
  <!-- 个人信息卡 -->
  <view class="profile-header card">
    <view class="avatar-fallback">
      <text>梦</text>
    </view>
    <text class="nickname">{{displayName}}</text>
    <text class="user-code">{{userCode}}</text>
    <view class="points-badge" wx:if="{{serviceAvailable}}">
      <text class="points-num">{{points}}</text>
      <text class="points-label">积分</text>
    </view>
    <view class="profile-note" wx:else>
      <text>画面灵感整理者</text>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="card">
    <view class="about-panel" wx:if="{{!serviceAvailable}}">
      <text class="about-title">关于梦倩绘境</text>
      <text class="about-desc">这是一个用于整理画面灵感的小册子。你可以在画廊浏览配色与构图参考，在收藏页查看适合长期保存的画面方向。</text>
    </view>
    <view class="menu-item" wx:if="{{serviceAvailable}}" bindtap="goCheckin">
      <view class="menu-icon" style="background:linear-gradient(135deg,#55efc4,#00b894);">
        <text style="font-size:36rpx;">📅</text>
      </view>
      <text class="menu-text">每日签到</text>
      <text class="menu-badge" wx:if="{{!checkedIn}}">签到领积分</text>
      <text class="menu-badge done" wx:else>已签到</text>
    </view>
    <view class="menu-item" wx:if="{{serviceAvailable}}" bindtap="goCdk">
      <view class="menu-icon" style="background:linear-gradient(135deg,#fab1a0,#fd79a8);">
        <text style="font-size:36rpx;">🎁</text>
      </view>
      <text class="menu-text">兑换码</text>
    </view>
    <view class="menu-item" wx:if="{{serviceAvailable}}" bindtap="goPoints">
      <view class="menu-icon" style="background:linear-gradient(135deg,#a29bfe,#6c5ce7);">
        <text style="font-size:36rpx;">💰</text>
      </view>
      <text class="menu-text">积分记录</text>
    </view>
    <button class="menu-item share-invite" wx:if="{{serviceAvailable}}" open-type="share">
      <view class="menu-icon" style="background:linear-gradient(135deg,#ffd166,#ef476f);">
        <text style="font-size:36rpx;">邀</text>
      </view>
      <view class="menu-main">
        <text class="menu-text">邀请好友赚积分</text>
        <text class="menu-sub">{{inviteRewardText}}</text>
      </view>
      <text class="menu-badge community">分享</text>
    </button>
    <view class="menu-item" bindtap="openCommunity">
      <view class="menu-icon" style="background:linear-gradient(135deg,#233026,#70a342);">
        <text style="font-size:36rpx;">👥</text>
      </view>
      <view class="menu-main">
        <text class="menu-text">{{communityMenuText}}</text>
        <text class="menu-sub">{{communityMenuSub}}</text>
      </view>
      <text class="menu-badge community">{{communityBadgeText}}</text>
    </view>
  </view>

  <!-- 明细记录 -->
  <view class="card" wx:if="{{showPointLogsPanel}}">
    <text class="section-title-inner">积分变动</text>
    <view wx:for="{{pointLogs}}" wx:key="id" class="log-item">
      <view class="log-left">
        <text class="log-type">{{item.typeText}}</text>
        <text class="log-remark">{{item.remark}}</text>
      </view>
      <text class="log-amount {{item.amountClass}}">{{item.amountText}}</text>
    </view>
  </view>

  <view class="community-modal" wx:if="{{showCommunity}}">
    <view class="community-mask" bindtap="closeCommunity"></view>
    <view class="community-card">
      <view class="community-mark">梦</view>
      <text class="community-title">{{communityTitle}}</text>
      <text class="community-desc">{{communityDesc}}</text>
      <view class="wechat-card-box">
        <view class="wechat-card-loading" wx:if="{{!authorWechatCardLoaded}}">名片码加载中...</view>
        <image
          class="wechat-card-image"
          src="{{authorWechatCard}}"
          mode="aspectFit"
          show-menu-by-longpress
          bindload="onWechatCardLoad"
          bindtap="previewWechatCard"
        />
      </view>
      <view class="community-actions">
        <button class="community-btn secondary" bindtap="closeCommunity">关闭</button>
        <button class="community-btn primary" bindtap="previewWechatCard">{{authorWechatCardLoaded ? communityBadgeText : '加载中...'}}</button>
      </view>
    </view>
  </view>
</view>
