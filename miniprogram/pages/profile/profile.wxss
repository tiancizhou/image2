.profile-header {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 32rpx;
}

.avatar,
.avatar-fallback {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 4rpx solid #f0edff;
}

.avatar-fallback {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8e8;
  background: linear-gradient(135deg, #233026, #70a342);
  border-color: #f4ffdf;
  font-size: 52rpx;
  font-weight: 900;
  box-shadow: 0 14rpx 34rpx rgba(82, 130, 48, 0.22);
}

.nickname {
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 16rpx;
  color: #333;
}

.user-code {
  margin-top: 4rpx;
  color: #9d8d78;
  font-size: 22rpx;
}

.points-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 16rpx;
  background: linear-gradient(135deg, #ffeaa7, #fdcb6e);
  padding: 12rpx 40rpx;
  border-radius: 24rpx;
}

.points-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #6c5ce7;
}

.points-label {
  font-size: 20rpx;
  color: #636e72;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0edff;
}

.menu-item:last-child { border-bottom: none; }

.menu-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  font-weight: 500;
}

.menu-main {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.menu-main .menu-text {
  flex: none;
}

.menu-sub {
  margin-top: 6rpx;
  color: #9d8d78;
  font-size: 22rpx;
}

.menu-badge {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  background: linear-gradient(135deg, #55efc4, #00b894);
  color: #fff;
}

.menu-badge.done {
  background: #dfe6e9;
  color: #b2bec3;
}

.menu-badge.community {
  background: linear-gradient(135deg, #233026, #70a342);
}

.section-title-inner {
  font-size: 26rpx;
  font-weight: 600;
  color: #636e72;
  margin-bottom: 16rpx;
}

.log-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0edff;
}

.log-left { display: flex; flex-direction: column; }

.log-type {
  font-size: 26rpx;
  font-weight: 500;
  color: #333;
}

.log-remark {
  font-size: 22rpx;
  color: #b2bec3;
  margin-top: 4rpx;
}

.log-amount { font-size: 28rpx; font-weight: 600; }
.positive { color: #00b894; }
.negative { color: #e17055; }

.community-modal {
  position: fixed;
  inset: 0;
  z-index: 30;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
}

.community-mask {
  position: absolute;
  inset: 0;
  background: rgba(35, 48, 38, 0.48);
  backdrop-filter: blur(8rpx);
}

.community-card {
  position: relative;
  z-index: 1;
  width: 100%;
  padding: 44rpx 36rpx 34rpx;
  border-radius: 38rpx;
  background:
    radial-gradient(circle at 18% 0%, rgba(112, 163, 66, 0.16), transparent 280rpx),
    #fffaf0;
  box-shadow: 0 28rpx 80rpx rgba(35, 48, 38, 0.22);
  display: flex;
  flex-direction: column;
  align-items: center;
}

.community-mark {
  width: 104rpx;
  height: 104rpx;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff8e8;
  background: linear-gradient(135deg, #233026, #70a342);
  font-size: 44rpx;
  font-weight: 900;
}

.community-title {
  margin-top: 28rpx;
  color: #233026;
  font-size: 34rpx;
  font-weight: 800;
}

.community-desc {
  margin-top: 16rpx;
  color: #8c7b65;
  font-size: 25rpx;
  line-height: 1.8;
  text-align: center;
}

.wechat-card-box {
  width: 100%;
  margin-top: 30rpx;
  padding: 18rpx;
  border-radius: 30rpx;
  background: #f4ead9;
  display: flex;
  justify-content: center;
  align-items: center;
}

.wechat-card-image {
  width: 430rpx;
  height: 560rpx;
  border-radius: 24rpx;
  background: #fff;
}

.community-actions {
  width: 100%;
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.community-btn {
  flex: 1;
  height: 86rpx;
  line-height: 86rpx;
  border-radius: 999rpx;
  font-size: 28rpx;
}

.community-btn::after {
  border: 0;
}

.community-btn.secondary {
  color: #6e5e4a;
  background: #efe3d0;
}

.community-btn.primary {
  color: #fffaf0;
  background: linear-gradient(135deg, #233026, #70a342);
}
