.page {
  min-height: 100vh;
  padding: 18rpx 18rpx 120rpx;
  background:
    radial-gradient(circle at 0% 0%, rgba(255, 225, 168, 0.48), transparent 34%),
    linear-gradient(180deg, #fff8ef 0%, #fffdf8 54%, #f6fbf2 100%);
  box-sizing: border-box;
}

.history-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 18rpx;
}

.history-card {
  min-width: 0;
  overflow: hidden;
  border-radius: 24rpx;
  background: rgba(255, 255, 255, 0.92);
  box-shadow: 0 14rpx 36rpx rgba(92, 71, 41, 0.08);
}

.history-thumb {
  width: 100%;
  height: 300rpx;
  display: block;
  background: #f2eadf;
}

.history-thumb.placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  padding: 24rpx;
  box-sizing: border-box;
  color: #6c5ce7;
  font-size: 28rpx;
  font-weight: 700;
  background: linear-gradient(135deg, #f4f0ff, #fff8f0);
}

.history-thumb.placeholder.pending {
  color: #6c5ce7;
}

.history-thumb.placeholder.failed {
  color: #d63031;
  background: #fff1ef;
}

.error-text {
  max-width: 100%;
  color: #b05a4d;
  font-size: 20rpx;
  font-weight: 400;
  text-align: center;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
}

.history-meta {
  padding: 16rpx 18rpx 18rpx;
}

.meta-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10rpx;
}

.history-prompt {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #342c22;
  line-height: 1.35;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.status-badge {
  display: inline-flex;
  flex-shrink: 0;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #00b894;
  background: #e8fff7;
}

.status-badge.pending {
  color: #6c5ce7;
  background: #f0edff;
}

.status-badge.failed {
  color: #d63031;
  background: #fff1ef;
}

.history-type {
  min-width: 0;
  color: #a08f78;
  font-size: 20rpx;
  font-weight: 700;
}

.history-info {
  display: block;
  font-size: 20rpx;
  color: #a99a86;
  margin-top: 10rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.load-more {
  text-align: center;
  padding: 24rpx;
}

.load-more-text {
  color: #a29bfe;
  font-size: 26rpx;
}
