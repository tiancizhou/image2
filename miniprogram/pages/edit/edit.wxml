<view class="page">
  <view class="card">
    <text class="section-label">上传图片</text>
    <view class="upload-area" bindtap="onChooseImage">
      <image wx:if="{{sourceImage}}" class="preview-image" src="{{sourceImage}}" mode="aspectFit" />
      <view wx:else class="upload-placeholder">
        <text class="upload-icon">+</text>
        <text class="upload-text">点击上传图片</text>
      </view>
    </view>

    <text class="section-label">编辑描述</text>
    <textarea
      class="input-area"
      placeholder="描述你想要的编辑效果..."
      placeholder-style="color: #b2bec3;"
      value="{{prompt}}"
      bindinput="onPromptInput"
      maxlength="2000"
      auto-height
    />

    <text class="section-label">选择尺寸</text>
    <size-picker value="{{size}}" bind:change="onSizeChange" />

    <view class="info-bar">
      <text class="points-info">消耗 {{pointsCost}} 积分 · 当前 {{userPoints}} 积分</text>
    </view>

    <button
      class="btn btn-pink {{generating ? 'btn-disabled' : ''}}"
      bindtap="onEdit"
      disabled="{{generating}}"
    >
      {{generating ? '编辑中...' : '开始编辑'}}
    </button>
  </view>

  <view class="card" wx:if="{{generating}}">
    <view class="loading-wrap">
      <view class="loading-dots"><view></view><view></view><view></view></view>
      <text style="margin-top:24rpx;color:#fd79a8;font-size:26rpx;">AI 正在编辑中...</text>
    </view>
  </view>

  <view class="card" wx:if="{{resultImage}}">
    <text class="section-label">编辑结果</text>
    <image class="result-image" src="{{resultImage}}" mode="widthFix" show-menu-by-longpress />
    <button class="btn btn-mint" style="margin-top:20rpx;" bindtap="onSaveImage">保存到相册</button>
  </view>
</view>
