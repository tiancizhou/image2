.section-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #636e72;
  margin: 24rpx 0 16rpx;
}

.section-label:first-child { margin-top: 0; }

.upload-area {
  width: 100%;
  min-height: 300rpx;
  border-radius: 20rpx;
  background: #f8f0ff;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.upload-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: #b2bec3;
}

.upload-icon {
  font-size: 64rpx;
  line-height: 1;
}

.upload-text {
  font-size: 24rpx;
  margin-top: 8rpx;
}

.preview-image {
  width: 100%;
  height: 300rpx;
}

.info-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 0;
}

.points-info {
  font-size: 24rpx;
  color: #a29bfe;
}
