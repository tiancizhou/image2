<view class="page">
  <view class="hero-card">
    <view class="hero-glow"></view>
    <text class="kicker">梦倩绘境</text>
    <text class="hero-title">梦境画面灵感手册</text>
    <text class="hero-subtitle">收集配色、构图与画面氛围，整理属于你的梦中画境。</text>
    <view class="balance-row">
      <text>当前积分</text>
      <text>{{userPoints}}</text>
    </view>
  </view>

  <view wx:if="{{!serviceChecked}}" class="status-card service-checking">
    <view class="loading-wrap">
      <view class="loading-dots">
        <view></view><view></view><view></view>
      </view>
      <text class="loading-text">正在加载页面...</text>
    </view>
  </view>

  <view wx:if="{{serviceChecked && !serviceAvailable}}" class="gallery-card">
    <view class="gallery-badge">灵感手册</view>
    <text class="gallery-title">今日画面参考</text>
    <text class="gallery-desc">这里整理配色、构图与氛围参考。你可以完成每日签到，或浏览下方主题积累个人灵感。</text>
    <view class="closed-actions">
      <view class="closed-action checkin" bindtap="onClosedCheckinTap">
        <text class="closed-action-icon">签</text>
        <view>
          <text class="closed-action-title">每日签到</text>
          <text class="closed-action-desc">领取今日积分，连续签到有额外奖励</text>
        </view>
      </view>
      <view class="closed-action ad" bindtap="onClosedRewardAdTap">
        <text class="closed-action-icon">+{{rewardAdPoints}}</text>
        <view>
          <text class="closed-action-title">看广告领积分</text>
          <text class="closed-action-desc">完整观看一次激励视频，到账 {{rewardAdPoints}} 积分</text>
        </view>
      </view>
    </view>
    <view class="review-gallery-list">
      <view
        wx:for="{{galleryItems}}"
        wx:key="id"
        class="review-gallery-item"
        data-id="{{item.id}}"
        bindtap="onGalleryItemTap"
      >
        <image class="review-gallery-image" src="{{item.image}}" mode="aspectFill" data-id="{{item.id}}" bindtap="onGalleryImageTap" />
        <view>
          <text class="review-gallery-title">{{item.title}}</text>
          <text class="review-gallery-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>

  <view wx:if="{{serviceChecked && serviceAvailable}}" class="mode-switch">
    <view class="mode-item {{modeGenerateClass}}" bindtap="switchToGenerate">
      <text class="mode-title">文生图</text>
      <text class="mode-desc">从提示词开始</text>
    </view>
    <view class="mode-item {{modeEditClass}}" bindtap="switchToEdit">
      <text class="mode-title">图生图</text>
      <text class="mode-desc">上传参考图生成</text>
    </view>
  </view>

  <view wx:if="{{serviceChecked && serviceAvailable}}" class="studio-card">
    <view wx:if="{{isEditMode}}" class="source-panel">
      <view class="section-head">
        <text>参考图片</text>
        <text wx:if="{{sourceImage}}" class="text-action" bindtap="onRemoveSource">移除</text>
      </view>
      <view class="upload-area {{uploadAreaClass}}" bindtap="onChooseImage">
        <view wx:if="{{sourceFromHistory}}" class="history-source-card">
          <text class="history-source-icon">✓</text>
          <text class="history-source-title">已引用历史图片</text>
          <text class="history-source-desc">无需重新下载或上传，提交后直接进入队列</text>
        </view>
        <view wx:elif="{{sourceImages.length}}" class="preview-grid">
          <image wx:for="{{sourceImages}}" wx:key="*this" class="preview-tile" src="{{item}}" mode="aspectFill" />
          <view class="preview-count">{{sourceImages.length}}/4 张 · 点击继续添加</view>
        </view>
        <view wx:else class="upload-placeholder">
          <text class="upload-icon">+</text>
          <text class="upload-text">上传参考图</text>
          <text class="upload-hint">最多 4 张，支持相册或拍照</text>
        </view>
      </view>
    </view>

    <view class="section-head">
      <text>{{promptLabel}}</text>
      <text class="hint">{{promptLength}}/2000</text>
    </view>
    <textarea
      class="input-area"
      placeholder="{{promptPlaceholder}}"
      placeholder-style="color: #9d8d78;"
      value="{{prompt}}"
      bindinput="onPromptInput"
      maxlength="2000"
      auto-height
    />

    <view class="section-head size-head">
      <text>输出尺寸</text>
      <text class="hint">消耗 {{pointsCost}} 积分</text>
    </view>
    <size-picker value="{{size}}" pricing="{{sizePricing}}" bind:change="onSizeChange" />

    <view class="info-bar">
      <text class="points-info">本次 {{actionVerb}}预计消耗 {{pointsCost}} 积分</text>
      <text class="points-left">剩余 {{userPoints}} 积分</text>
    </view>

    <view class="reward-ad-tip {{userPoints < pointsCost ? 'urgent' : ''}}" bindtap="promptRewardAdForPoints">
      <view class="reward-ad-icon">AD</view>
      <view class="reward-ad-copy">
        <text class="reward-ad-title">{{userPoints < pointsCost ? '积分不足，立即补给' : '免费领取更多积分'}}</text>
        <text class="reward-ad-desc">看一次激励视频，到账 {{rewardAdPoints}} 积分</text>
      </view>
      <view class="reward-ad-action">{{rewardAdLoading ? '加载中' : '去领取'}}</view>
    </view>

    <button
      class="create-btn {{createBtnClass}}"
      bindtap="onCreate"
      disabled="{{generating}}"
    >
      {{actionText}}
    </button>
  </view>

  <view class="status-card" wx:if="{{generating}}">
    <view class="loading-wrap">
      <view class="loading-dots">
        <view></view><view></view><view></view>
      </view>
      <text class="loading-text">{{loadingText}}</text>
    </view>
  </view>

  <view class="result-card" wx:if="{{resultImage}}">
    <view class="section-head">
      <text>{{resultLabel}}</text>
      <text class="hint">点击图片可查看</text>
    </view>
    <image class="result-image" src="{{resultImage}}" mode="widthFix" show-menu-by-longpress />
    <button class="save-btn" bindtap="onSaveImage">保存到相册</button>
  </view>

  <view class="task-mask" wx:if="{{showQuickCheckin}}" catchtap="onCloseQuickCheckin">
    <view class="checkin-modal" catchtap="noop">
      <view class="checkin-sun">签</view>
      <text class="task-kicker">DAILY BONUS</text>
      <text class="task-title">今天还没有签到</text>
      <text class="task-desc">{{quickCheckinRewardText}}</text>
      <view class="checkin-streak" wx:if="{{checkinConsecutive > 0}}">当前连续 {{checkinConsecutive}} 天</view>
      <view class="task-actions">
        <view class="task-btn secondary" bindtap="onCloseQuickCheckin">稍后再说</view>
        <view class="task-btn primary" bindtap="onQuickCheckin">{{quickCheckinLoading ? '签到中...' : '立即签到'}}</view>
      </view>
    </view>
  </view>

  <view class="task-mask" wx:if="{{showTaskModal}}" catchtap="onCloseTaskModal">
    <view class="task-modal" catchtap="noop">
      <view class="task-orbit">
        <view class="task-dot"></view>
      </view>
      <text class="task-kicker">{{taskAccepted ? 'TASK ACCEPTED' : 'SUBMITTING'}}</text>
      <text class="task-title">{{taskAccepted ? '创作任务已进入队列' : '正在提交任务'}}</text>
      <text class="task-desc">{{taskAccepted ? 'AI 正在后台生成。完成后会出现在历史列表；提交时会先冻结积分，渠道失败会自动返还。' : taskSubmittingText}}</text>
      <view wx:if="{{!taskAccepted}}" class="task-progress">
        <view class="loading-dots"><view></view><view></view><view></view></view>
      </view>
      <view wx:if="{{taskAccepted}}" class="task-id">任务 #{{submittedTaskId}}</view>
      <view wx:if="{{taskAccepted}}" class="task-actions">
        <view class="task-btn secondary" bindtap="onCloseTaskModal">继续创作</view>
        <view class="task-btn primary" bindtap="onGoHistory">去历史查看</view>
      </view>
    </view>
  </view>

  <view class="preview-mask" wx:if="{{previewVisible}}" catchtap="closeGalleryPreview">
    <view class="preview-panel" catchtap="noop">
      <image class="preview-panel-image" src="{{previewItem.image}}" mode="aspectFit" />
      <text class="preview-panel-title">{{previewItem.title}}</text>
      <text class="preview-panel-desc">{{previewItem.desc}}</text>
      <button class="preview-close" bindtap="closeGalleryPreview">关闭</button>
    </view>
  </view>

  <view class="community-card-mask" wx:if="{{showCommunityCard}}" catchtap="closeCommunityCard">
    <view class="community-card-panel" catchtap="noop">
      <view class="community-card-head">
        <view>
          <text class="community-card-kicker">COMMUNITY</text>
          <text class="community-card-title">{{communityTitle}}</text>
        </view>
        <view class="community-card-close" bindtap="closeCommunityCard">×</view>
      </view>
      <text class="community-card-desc">{{communityDesc}}</text>
      <view class="community-image-wrap">
        <view class="community-image-loading" wx:if="{{!communityImageLoaded}}">
          <view class="loading-dots"><view></view><view></view><view></view></view>
          <text>名片码加载中...</text>
        </view>
        <image
          class="community-card-image"
          src="{{communityImageUrl}}"
          mode="aspectFit"
          bindload="onCommunityImageLoad"
          bindtap="previewCommunityImage"
        />
      </view>
      <text class="community-card-tip">点击名片码可放大查看，长按识别或保存。</text>
    </view>
  </view>
</view>
