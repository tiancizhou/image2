.size-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.size-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 16rpx;
  border-radius: 20rpx;
  background: #f8f0ff;
  min-width: 120rpx;
  flex: 1;
  transition: all 0.25s ease-out;
}

.size-active {
  background: linear-gradient(135deg, #a29bfe, #6c5ce7);
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.3);
}

.size-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  margin-bottom: 8rpx;
}

.size-rect {
  border: 3rpx solid #6c5ce7;
  border-radius: 6rpx;
  transition: all 0.25s;
}

.size-active .size-rect {
  border-color: #fff;
}

.size-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #6c5ce7;
}

.size-active .size-label {
  color: #fff;
}

.size-desc {
  font-size: 18rpx;
  color: #b2bec3;
  margin-top: 4rpx;
}

.size-active .size-desc {
  color: rgba(255, 255, 255, 0.7);
}
